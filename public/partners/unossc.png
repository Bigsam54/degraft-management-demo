<style id='mfn-custom-inline-css' type='text/css'>
/* Blue Line */
/* .header-plain #Action_bar {border-bottom: #009bd7 solid 4px !important;} */

/* Menu */
.header-plain #Top_bar .menu > li.current-menu-item > a, .header-plain #Top_bar .menu > li.current_page_item > a {background: rgba(76, 175, 80, 0.0);}
.menu-highlight #Top_bar #menu > ul > li.current-menu-item > a, .menu-highlight #Top_bar #menu > ul > li.current_page_item > a {background: rgba(76, 175, 80, 0.0);}
/* Menu space adjustments (temporary while South-South Galaxi is there) */
.header-plain #Top_bar .menu_wrapper {margin-left: 25px;}
.header-plain #Top_bar .menu > li > a span:not(.description) {padding: 0 27px;}

/* SubMenu */
#Top_bar .menu li ul {top: 80%;}
#Top_bar .menu > li ul {font-size: 14px !important; line-height: 22px !important;}

/* Breadcrumbs */
#Subheader {padding-left: 1%;}
#Subheader ul.breadcrumbs li span {margin: 0 2px;}
#Subheader ul.breadcrumbs {font-size: 14px !important; line-height: 22px !important;}

/* Footer */
#Footer .widget_nav_menu ul {color: #ffffff !important; font-size: 14px; line-height: 20px; margin: 0; padding-top: 0; padding-bottom: 0; background: none;}
#Footer .widget_nav_menu ul li a {padding: 4px 0 4px 3px;}
#Footer .footer_copy .one {margin-bottom: 10px; padding-top: 25px;}

/* Pages and Posts */
#Content {padding-bottom: 80px;}
.the_content_wrapper {font-family: Georgia, serif !important;}

/* Posts */
.post-meta {font-size: 17px !important; line-height: 22px !important;} /* size of post date */
.share-simple-wrapper {margin-top: 30px;} /* share post */
.share-simple-wrapper .share-label {font-family: "Roboto", sans-serif;} /* share post */

/* Captions */
.wp-caption-text {font-family: Georgia, serif !important; background: #ffffff !important; color: #333333; font-size: 80%;}

/* Adjustments Mobile */
@media only screen and (max-width: 767px)
{
.header-plain #Top_bar {height: 100px;} /* header */
#Top_bar #logo img.logo-mobile {max-height: 80px !important; padding-top: 8px;}
#Top_bar #logo img.logo-mobile-sticky {max-height: 80px !important; padding-top: 10px;}
#Subheader {padding-top: 60px;} /* subheader */
#Subheader .title {font-size: 18px !important;} /* subheader font increase */
#Side_slide .extras .extras-wrapper a {font-size: 15px;} /* menu */
.the_content_wrapper {font-size: 15px !important; line-height: 24px !important; font-family: Georgia, serif !important;} /* increase font pages & posts */
.section_wrapper, .container, .four.columns .widget-area {padding-left: 20px !important; padding-right: 20px !important;} /* reduce margins */
}

/* Adjustments Fonts Mobile */
@media only screen and (max-width: 767px)
{
h6 {font-size: 13px; line-height: 19px; font-weight: 600;}
h5 {font-size: 14px; line-height: 20px; font-weight: 600;}
h4 {font-size: 15px; line-height: 21px; font-weight: 600;}
.icon_box h4 {font-size: 18px; line-height: 24px; font-weight: 600;}
.style-simple .icon_box .icon_wrapper {margin-bottom: 0px;}
}

/* Buttons */
.button-default .button, .button-flat .button, .button-round .button {font-family: "Roboto", sans-serif; line-height: 130%;}

/* Quotes */
.style-simple blockquote {font-size: 100%; line-height: 150%;}
.blockquote p.author {font-family: "Roboto", sans-serif; font-size: 90%;}

/* Caption */
.wp-caption-text {background: #ffffff !important; color: #333333; font-size: 80%;}

/* Side Bar */
.widget_recent_entries ul {font-size: 16px !important; line-height: 24px !important;}
.widget_recent_entries ul li:after {width: 0px; background-color: #0068b3;}
.mcb-sidebar.style-simple {border-color: #ebebeb!important;}
@media only screen and (max-width: 1239px) /* hide on mobile and tablet */
{
.with_aside .sections_group {width: 100%;}
.with_aside .sidebar.columns {display: none}
}

/* Page - Highlight Photo (responsiveness) */
.mhlpage {margin: 10px 0px 20px 30px;}
@media only screen and (min-width: 768px) and (max-width: 1239px)
{
.mhlpage {width: 480px;}
}
@media only screen and (max-width: 767px)
{
.mhlpage {width: 770px;}
}

/* Blog (default, for general use in posts and pages) */
@media only screen and (min-width: 768px) /* desktop */
{
.blog_wrapper .post-desc .post-title .entry-title {font-size: 120% !important; line-height: 130% !important;}
.blog_wrapper .post-excerpt {font-size: 90% !important; line-height: 130% !important;}
.blog_wrapper .post-photo-wrapper {width: 25%; float: left;}
.blog_wrapper .post-desc-wrapper {width: 75%; float: right; padding-right: 0px;}
.blog_wrapper .post-desc {padding-top:0px;}
}
@media only screen and (max-width: 767px) /* mobile */
{
.blog_wrapper .post-desc .post-title .entry-title {font-size: 130% !important; line-height: 130% !important;}
.blog_wrapper .post-excerpt {font-size: 100% !important; line-height: 130% !important;}
.blog_wrapper .post-meta .author-date {font-size: 13px;}
}
.blog_wrapper {font-family: "Roboto", sans-serif;}
.blog_wrapper .image_frame {border-color: #dddddd;}
.blog_wrapper .image_frame, .wp-caption {border-width: 1px;}

#Content {padding-top: 0px; padding-bottom: 0px;}
.button.button_size_1 {font-size: 80%; padding-top: 4px; padding-bottom: 4px;}
a {color: #777777;} /* for 'what we do' area */

/* Hide description texts on top part for tablet mode */
@media only screen and (min-width: 960px) and (max-width: 1239px)
{
.text_top_fp {display: none;}
}

/* Highlights: Image w/ Text - Desktop */
.nghtitlerrkadj .wp-caption-text {padding-top:13px !important; text-align: left; background: transparent; color: #161922; font-family: "Roboto", Arial, Tahoma, sans-serif; font-size: 100% !important; line-height: 140% !important; font-weight: 600 !important;}

/* Highlights: Article Box - Mobile */
.mgwimgrrkmadj .article_box .photo_wrapper {width: 40%;}
.mgwtxtrrkmadj .article_box .desc_wrapper {width: 60%; padding-top: 3px; padding-left: 15px; min-height: 0px; justify-content: flex-start; background-color: rgba(0,0,0,0.0); background-image: url();}
.mgwtitlerrkmadj h4 {font-family: "Roboto", Arial, Tahoma, sans-serif; font-size: 120% !important; line-height: 130% !important; font-weight: 600 !important;}
.mgwimgrrkmborder .article_box .photo_wrapper {border-style: solid; border-color: #eeeeee !important; border-width: 1px !important;}
.mgwnorarrowrrkm .desc_wrapper i.icon-right-open {display: none;}
.mgwmargrrkmbottom20 .article_box {margin-bottom: 20px;}

/* Across the Globe & Publications: Blog Slider - Desktop & Mobile (works for Column Text too) */
.ktpbloslid h4 {font-family: "Roboto", Arial, Tahoma, sans-serif; font-size: 94% !important; line-height: 120% !important; font-weight: 600 !important;} /* Desktop */
.ktpbloslidmb h4 {font-family: "Roboto", Arial, Tahoma, sans-serif; font-size: 120% !important; line-height: 130% !important; font-weight: 600 !important;} /* Mobile */
.ktpnodate .blog_slider.flat .blog_slider_ul li .item_wrapper .date_label {display:none;}
.kdeborda .image_wrapper {border-style: solid; border-color: #dddddd !important; border-width: 1px !important;}

/* -------------------------------------------------- */
/* Others: (in the repository, not used at the moment */
/* -------------------------------------------------- */

/* Main Highlights Blog News */
.ngimgradj .Latest_news ul li .photo {width: 65.9%;}
.ngtxtradj .Latest_news ul li.has-post-thumbnail .desc {margin-left: 65.9%; width: 30%; padding-left: 25px;}
.ngtitleradj h5 {font-family: "Roboto", Arial, Tahoma, sans-serif; font-size: 200% !important; line-height: 120% !important; font-weight: 600 !important;}
.ngexcerptradj .Latest_news ul li .desc .post-excerpt {font-size: 130% !important;}
.ngwhiterline .Latest_news ul li .photo {border-color: #ffffff;}
.ngnordater .Latest_news ul li .desc_footer {border-top-width:3px; padding-top:4px; border-color:#dddddd; height:0px; max-width:100px; margin-top:14px;}
/* .ngnordater .Latest_news ul li .desc_footer {display:none;} */

/* Highlights Blog News */
.ngimgrradj .Latest_news ul li .photo {width: 55%;}
.ngtxtrradj .Latest_news ul li.has-post-thumbnail .desc {margin-left: 55%; width: 40%; padding-left: 15px;}
.ngtitlerradj h5 {font-family: "Roboto", Arial, Tahoma, sans-serif; font-size: 130% !important; line-height: 120% !important; font-weight: 600 !important;}
.ngwhiterrline .Latest_news ul li .photo {border-color: #ffffff;}
.ngnordaterr .Latest_news ul li .desc_footer {border-top-width:3px; padding-top:0px; border-color:#dddddd; height:0px; max-width:80px; margin-top:12px;}
.ng2margrrkbottom20 .Latest_news ul li {margin-bottom:24px;}

/* Highlights Blog News Horizontal */
.hgimgrradj .Latest_news.featured ul {width:100%;}
.hgtitlerradj h4 {font-family: "Roboto", Arial, Tahoma, sans-serif; font-size: 130% !important; line-height: 120% !important; font-weight: 600 !important;}
.hgwhiterrline .Latest_news ul li .photo {border-color: #ffffff;}
.hgnordaterr .Latest_news ul li .desc_footer {display:none;}
/* .hgnordaterr .Latest_news ul li .desc_footer {border-top-width:3px; padding-top:0px; border-color:#dddddd; height:0px; max-width:160px; margin-top:12px;} */

/* Highlights Article Box */
.ngfimgrrkadj .article_box .photo_wrapper {width: 55%;}
.ngftxtrrkadj .article_box .desc_wrapper {width: 40%; padding-top: 3px; padding-left: 15px; min-height: 0px; background-color: rgba(0,0,0,0.0); background-image: url();}
.ngftitlerrkadj h4 {font-family: "Roboto", Arial, Tahoma, sans-serif; font-size: 130% !important; line-height: 120% !important; font-weight: 600 !important;}
.ngfgraylinexx .article_box .desc_wrapper p {border-bottom-width: 3px; border-style: solid; border-color:#dddddd; padding-bottom: 20px; margin-bottom: 14px; max-width: 80px; height: 0px; text-indent: -10000px;}
.ngfimgrrkborder .article_box .photo_wrapper {border-style: solid; border-color: #eeeeee !important; border-width: 1px !important;}
.ngfnorarrowrrk .desc_wrapper i.icon-right-open {display: none;}
.ngfmargrrkbottom20 .article_box {margin-bottom: 24px;}

/* Highlights Blog News Mobile*/
.bmgtitlerrrmadj h4 {font-family: "Roboto", Arial, Tahoma, sans-serif; font-size: 130% !important; line-height: 120% !important; font-weight: 600 !important;}
